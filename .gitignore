# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Environment / secrets
.env
.streamlit/secrets.toml

# Data / caches
.chroma/
chroma/
*.sqlite3
.cache/
data/

# Observability sink (FINBRIEF_LOG_FILE, T8). The recommended path is data/events.jsonl, which
# the rule above already covers; the filename is named separately so pointing the sink somewhere
# else does not silently make a live run's log committable. These lines carry a blocked question's
# normalised text (config.GATE_LOGGED_INPUT_MAX_CHARS) and are a run artifact, never a source file.
events.jsonl

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/

# OS / editor
.DS_Store
.vscode/

# Agent skill definitions (vendored tooling; tracked via skills-lock.json)
.agents/skills/
.claude/skills/

# ralphex run state (progress logs, worktrees). It ships a nested .gitignore that already
# covers its contents; this makes the exclusion the repo's, not a tool-generated file's.
.ralphex/


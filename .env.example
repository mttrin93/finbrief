# --- LLM access (OpenRouter, OpenAI-compatible) ---
# Required. The app reports a clear error and stops without it.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Data sources ---
# Required for ingestion: the SEC rejects unidentified traffic, and
# scripts/ingest_filings.py fails loudly without a contact identity.
SEC_EDGAR_USER_AGENT=finbrief your-email@example.com
# Not read by anything yet. The finance tools (T5, #9) use yfinance and news RSS, both keyless;
# Alpha Vantage would be a *fundamentals fallback* for when yfinance returns nothing, and its
# free tier is 25 calls a day. Deferred rather than shipped — the TTL cache, the retry and the
# stale-data banner are how FinBrief survives the free tier today. See README, "What the live
# figures are, and are not".
ALPHAVANTAGE_API_KEY=
FRED_API_KEY=

# --- App ---
LOG_LEVEL=INFO
# Where the JSON-lines events append (T8, #10). **Unset means nowhere** — events go to stderr
# only, which is the terminal scrollback of whoever started the app, and nothing survives the
# process. **Commented out on purpose**, so that copying this file to `.env` — which the README
# and the app's own config banner both tell you to do — leaves the sink off, exactly as the code
# default, the README and ADR-0011 all describe it. Shipping it uncommented made "off by default"
# false for every reader who followed the setup instructions (issue #10 review).
#
# **Uncomment it for any run whose numbers you intend to report.** T10's evaluation harness reads
# latency samples (ADR-0005's ≤1.5s p50 added by translation), token counts, the
# agent-vs-original query divergence rate and gate-trigger metadata back out of this file, and a
# live run with the sink off leaves no record of any of them. Gitignored; append-only, never
# rotated. One caveat worth knowing before you keep one: a *blocked* question's normalised text
# is on its `input_gate` line, bounded by GATE_LOGGED_INPUT_MAX_CHARS — the one documented
# exception to the no-user-content rule (ADR-0006, config.py). That is the reason this line is
# opt-in rather than a default: enabling it is a decision to keep that text on disk.
#FINBRIEF_LOG_FILE=data/events.jsonl

# --- Optional switches (defaults shown; see src/finbrief/config.py) ---
#FINBRIEF_CHAT_MODEL=openai/gpt-4o-mini
# The input gate's zero-shot classifier (ADR-0006 layer 3). Its own field rather than
# FINBRIEF_CHAT_MODEL because the two are priced against different jobs: the gate pays for one
# YES/NO per turn. Bounded to 5s with no retry, and it fails open onto the other three layers.
# There is deliberately no switch to turn the gate off.
#FINBRIEF_CLASSIFIER_MODEL=openai/gpt-4o-mini
# The model RAGAs scores with (T10, #11). Deliberately NOT FINBRIEF_CHAT_MODEL: a judge that is
# the answering model grades its own output, which is the circularity ADR-0002's source-separated
# golden set exists to avoid. Stronger than the answerer rather than cheaper, unlike the gate —
# a judge that misreads a filing passage moves every number in the report. Only
# scripts/evaluate.py reads it.
#FINBRIEF_JUDGE_MODEL=openai/gpt-4.1-mini
# One model for ingest and query; changing it invalidates an existing index.
#FINBRIEF_EMBEDDING_MODEL=openai/text-embedding-3-small
# Retrieval strategy and translation — the two A/B axes (ADR-0002), and they move
# independently. Both are honoured by the answer path (T6, #6): the defaults are the
# pre-registered shipping configuration, hybrid + translation (ADR-0005), fixed before any
# A/B data existed. The sidebar states what is running and the "How I answered" panel shows
# what it did.
#FINBRIEF_RETRIEVAL_STRATEGY=hybrid   # vector | hybrid
#FINBRIEF_QUERY_TRANSLATION=true
# Top-k *after* RRF fusion, and also how deep each candidate list is fetched.
#FINBRIEF_RETRIEVAL_K=5
# Capped at 3 — ADR-0004's latency budget is a ceiling, not a default, so a higher
# value fails at startup rather than quietly invalidating the A/B result. At 0 the
# sub-query planner is skipped entirely (no chat call) and translation reduces to the
# deterministic ticker-form variant: the cell that isolates what the planner contributes.
# RRF_K is deliberately not an env var — see config.py.
#FINBRIEF_MAX_SUB_QUERIES=3
# Where the persisted Chroma collections live. Ingest and app must agree, so override
# it in both places or neither.
#FINBRIEF_CHROMA_DIR=data/chroma
# The agent's conversation memory (ADR-0008): a SQLite file, created on demand. Override it
# where the repo directory is not writable. Losing it loses conversations and nothing else —
# they are not treated as durable data, and on Streamlit Community Cloud the file is
# ephemeral by design.
#FINBRIEF_CHECKPOINT_DB=data/checkpoints.sqlite
# Feature flags
#FINBRIEF_EVAL_MODE=false
#FINBRIEF_ALPHAVANTAGE_ENABLED=false
